# =============================================================================
# PixFlow — environment configuration
# Copy to .env and adjust for your machine: cp .env.example .env
# =============================================================================

APP_NAME=PixFlow
APP_ENV=local
APP_KEY=
APP_DEBUG=true

# Public URL of the app (no trailing slash).
# Production (Hostinger, domain root):
#   APP_URL=https://pixflow.jinsta.com
# WAMP subdirectory example:
#   APP_URL=http://localhost/pixflow/public
# ngrok example:
#   APP_URL=https://your-subdomain.ngrok-free.app/pixflow/public
APP_URL=http://localhost/pixflow/public

# Subdirectory only (WAMP/XAMPP). Leave EMPTY on Hostinger / php artisan serve.
APP_BASE_PATH=/pixflow/public
ASSET_URL="${APP_URL}"

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# -----------------------------------------------------------------------------
# Database
# -----------------------------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=pixflow
DB_USERNAME=root
DB_PASSWORD=

# SQLite alternative:
# DB_CONNECTION=sqlite
# DB_DATABASE=database/database.sqlite

# -----------------------------------------------------------------------------
# Session, cache & queues (required for scheduling + automation)
# -----------------------------------------------------------------------------
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Set true when using HTTPS (ngrok/production)
SESSION_SECURE_COOKIE=false

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
QUEUE_CONNECTION=database
CACHE_STORE=database

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# -----------------------------------------------------------------------------
# Mail
# -----------------------------------------------------------------------------
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@pixflow.local"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# =============================================================================
# Social platforms — Facebook, Instagram, Pinterest
# Set SOCIAL_MOCK_MODE=true to test UI without real API credentials.
# =============================================================================
SOCIAL_MOCK_MODE=false

FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
FACEBOOK_REDIRECT_URI="${APP_URL}/auth/facebook/callback"
FACEBOOK_SANDBOX=false
# Set true after Meta App Review enables pages_manage_posts on your app.
FACEBOOK_REQUEST_PUBLISH_SCOPES=false
FACEBOOK_OAUTH_SCOPES=public_profile,pages_show_list,pages_read_engagement,business_management

INSTAGRAM_CLIENT_ID=
INSTAGRAM_CLIENT_SECRET=
# Leave empty to reuse FACEBOOK_REDIRECT_URI when both use the same Meta app.
INSTAGRAM_REDIRECT_URI=
INSTAGRAM_SANDBOX=false

PINTEREST_CLIENT_ID=
PINTEREST_CLIENT_SECRET=
PINTEREST_REDIRECT_URI="${APP_URL}/auth/pinterest/callback"
PINTEREST_SANDBOX=true

# =============================================================================
# Manual post AI (Create Post wizard — caption suggestions)
# =============================================================================
AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_API_VERSION=v1beta
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image

# Comma-separated fallback chains used by the image generation service
AI_TEXT_PROVIDERS=openai,gemini
AI_IMAGE_PROVIDERS=openai,gemini,cursor

OPENAI_IMAGE_MODEL=dall-e-3
OPENAI_IMAGE_QUALITY=standard

# =============================================================================
# AI Automation pipeline (campaigns, topics, Cursor agents)
# =============================================================================
AUTOMATION_ENABLED=true
# Primary text provider for automation: cursor, openai, or gemini
AUTOMATION_AI_PROVIDER=cursor
# Optional image override (openai, gemini, cursor). Empty = smart default from API keys.
AUTOMATION_IMAGE_PROVIDER=
# Force Cursor for images even when OpenAI/Gemini keys exist
# AUTOMATION_IMAGE_STRICT_CURSOR=false
# Per-platform image override, e.g. gemini for Pinterest infographics
# AUTOMATION_IMAGE_PROVIDER_PINTEREST=gemini

AUTOMATION_AI_AGENT_EMAIL=ai-agent@pixflow.local
AUTOMATION_MAX_POSTS_PER_RUN=10
AUTOMATION_IMAGE_DAILY_LIMIT=50
AUTOMATION_TOPIC_COOLDOWN_DAYS=14
# Block risky health claims in generated copy when true
AUTOMATION_SAFETY_ENABLED=false
# Optional .ttf path for legacy layout-mode infographics
# AUTOMATION_INFOGRAPHIC_FONT=

# Auto-review agent for automation-generated pending posts
AUTO_REVIEW_ENABLED=false
AUTO_REVIEW_MIN_SCORE=75
AUTO_REVIEW_MIN_CONFIDENCE=0.65
AUTO_REVIEW_VISION_ENABLED=true
AUTO_REVIEW_DISPATCH_AFTER_CREATE=true
AUTO_REVIEW_SCAN_LIMIT=20
# AUTO_REVIEW_ALLOW_REREVIEW=false

# -----------------------------------------------------------------------------
# Cursor Cloud Agents API (https://api.cursor.com)
# -----------------------------------------------------------------------------
CURSOR_API_KEY=
CURSOR_API_BASE_URL=https://api.cursor.com/v1
CURSOR_API_MODE=cloud
CURSOR_AUTH=basic
CURSOR_CHAT_MODEL=auto
CURSOR_JSON_MODE=true
CURSOR_POLL_TIMEOUT=360
CURSOR_POLL_INTERVAL=3
CURSOR_ARCHIVE_AGENTS=true

# Image generation mode: agent (recommended), api, or layout
CURSOR_IMAGE_MODE=agent
CURSOR_IMAGE_VIA_ARTIFACTS=false
CURSOR_IMAGE_AGENT_FALLBACK=true
CURSOR_ARTIFACT_POLL_TIMEOUT=360
CURSOR_IMAGE_AGENT_POLL_TIMEOUT=480
CURSOR_IMAGE_DIMENSION_RETRIES=2
CURSOR_ARTIFACT_IMAGE_PATH=artifacts/post-image.png
# Optional OpenAI-compatible image endpoint when CURSOR_IMAGE_MODE=api
# CURSOR_IMAGE_API_URL=
# CURSOR_IMAGE_MODEL=

# -----------------------------------------------------------------------------
# Canva-style embedded metadata on AI-generated images (optional)
# -----------------------------------------------------------------------------
CANVA_METADATA_AUTHOR="PixFlow"
CANVA_METADATA_TITLE="Untitled design - 1"
CANVA_METADATA_FILE_NAME="Untitled design.png"
# CANVA_METADATA_DOC_ID=
# CANVA_METADATA_USER_ID=
# CANVA_METADATA_BRAND_ID=
# CANVA_METADATA_FB_ID=
# CANVA_METADATA_TOUCH_TYPE=2

# Media library / semi-AI upload limit in kilobytes (default 10240 = 10MB).
# PHP upload_max_filesize and post_max_size must be at least this high.
# MEDIA_MAX_UPLOAD_KB=10240
# MEDIA_MAX_UPLOAD_FILES=10

VITE_APP_NAME="${APP_NAME}"
